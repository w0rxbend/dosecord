.git
out/
.idea
.bsp
.mypy_cache
.pytest_cache

# Secrets never enter the build context: `COPY . .` would bake them into an
# image layer. `.env.example` is generated, holds placeholders only, and stays.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/secrets/

# Frontend dependencies and build output are not inputs of the image.
miniapp/node_modules
miniapp/dist
miniapp/screenshots
miniapp/test-results

# Local working state outside Git: the owner's live run and agent worktrees hold
# their own builds, databases and settings, none of which belongs in an image.
.live/
.claude/
