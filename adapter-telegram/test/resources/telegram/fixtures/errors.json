[
  { "name": "flood-429", "method": "sendMessage", "status": 429, "expect": "RateLimited",
    "body": { "ok": false, "error_code": 429, "description": "Too Many Requests: retry after 30", "parameters": { "retry_after": 30 } } },
  { "name": "blocked-403", "method": "sendMessage", "status": 403, "expect": "Unreachable",
    "body": { "ok": false, "error_code": 403, "description": "Forbidden: bot was blocked by the user" } },
  { "name": "deactivated-403", "method": "sendMessage", "status": 403, "expect": "Unreachable",
    "body": { "ok": false, "error_code": 403, "description": "Forbidden: user is deactivated" } },
  { "name": "never-started-403", "method": "sendMessage", "status": 403, "expect": "Unreachable",
    "body": { "ok": false, "error_code": 403, "description": "Forbidden: bot can't initiate conversation with a user" } },
  { "name": "chat-not-found-400", "method": "sendMessage", "status": 400, "expect": "Unreachable",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: chat not found" } },
  { "name": "not-modified-400", "method": "editMessageText", "status": 400, "expect": "NotModified",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: message is not modified: specified new message content and reply markup are exactly the same as a current content and reply markup of the message" } },
  { "name": "edit-not-found-400", "method": "editMessageText", "status": 400, "expect": "MissingTarget",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: message to edit not found" } },
  { "name": "edit-not-editable-400", "method": "editMessageText", "status": 400, "expect": "MissingTarget",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: message can't be edited" } },
  { "name": "delete-window-400", "method": "deleteMessage", "status": 400, "expect": "NotDeletable",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: message can't be deleted for everyone" } },
  { "name": "delete-not-found-400", "method": "deleteMessage", "status": 400, "expect": "MissingTarget",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: message to delete not found" } },
  { "name": "callback-expired-400", "method": "answerCallbackQuery", "status": 400, "expect": "CallbackExpired",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: query is too old and response timeout expired or query ID is invalid" } },
  { "name": "wrong-file-id-400", "method": "sendPhoto", "status": 400, "expect": "BadMedia",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: wrong file identifier/HTTP URL specified" } },
  { "name": "parse-entities-400", "method": "sendMessage", "status": 400, "expect": "BadRequest",
    "body": { "ok": false, "error_code": 400, "description": "Bad Request: can't parse entities: Unsupported start tag \"CANARY-DESCRIPTION\" at byte offset 9" } },
  { "name": "unauthorized-401", "method": "getMe", "status": 401, "expect": "TokenInvalid",
    "body": { "ok": false, "error_code": 401, "description": "Unauthorized" } },
  { "name": "not-found-404", "method": "getMe", "status": 404, "expect": "TokenInvalid",
    "body": { "ok": false, "error_code": 404, "description": "Not Found" } },
  { "name": "conflict-409", "method": "getUpdates", "status": 409, "expect": "Conflict",
    "body": { "ok": false, "error_code": 409, "description": "Conflict: terminated by other getUpdates request; make sure that only one bot instance is running" } },
  { "name": "server-500", "method": "sendMessage", "status": 500, "expect": "Unavailable",
    "body": { "ok": false, "error_code": 500, "description": "Internal Server Error" } },
  { "name": "gateway-502", "method": "sendMessage", "status": 502, "expect": "Unavailable",
    "body": { "ok": false, "error_code": 502, "description": "Bad Gateway" } }
]
