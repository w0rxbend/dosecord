//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.2
//| # Exact coordinate: the `::` platform-suffix form resolves
//| # mill-contrib-scoverage_mill1_3, which is not published; the Mill-1.1.9
//| # contrib artifact is mill-contrib-scoverage_3.
//| - com.lihaoyi:mill-contrib-scoverage_3:1.1.9

package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*, scalalib.*, scalafmt.*
import mill.contrib.scoverage.ScoverageModule

// Versions pinned per docs/DESIGN.md section 2: Scala 3.8.4, Ox 1.0.6,
// upickle 4.4.3, munit 1.3.6, munit-scalacheck 1.3.1.
trait DosecordModule extends ScalaModule, ScalafmtModule, ScalafixModule:
  def scalaVersion = "3.8.4"
  // Pin the build JDK: the Mill launcher otherwise auto-provisions its own JVM
  // (with a stale tzdb) and ignores JAVA_HOME. See docs/spikes/dst-primitives.md.
  def jvmVersion = "temurin:25"
  def scalacOptions = Seq("-Werror", "-Wunused:all", "-deprecation")

  trait DosecordTests extends ScalaTests, TestModule.Munit:
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.3.6",
      mvn"org.scalameta::munit-scalacheck:1.3.1"
    )

object contracts extends DosecordModule:
  def mvnDeps = Seq(mvn"com.lihaoyi::upickle:4.4.3")
  object test extends DosecordTests

object core extends DosecordModule, ScoverageModule:
  def moduleDeps = Seq(contracts)
  def mvnDeps = Seq(mvn"com.softwaremill.ox::core:1.0.6")
  // Coverage-gate scaffold (ROADMAP M0.4): instruments core so
  // scripts/coverage-gate.sh can measure statement coverage of
  // core/domain and core/chat against the 85% threshold armed at M1 exit.
  def scoverageVersion = "2.5.2"
  object test extends DosecordTests, ScoverageTests

object infra extends DosecordModule:
  def moduleDeps = Seq(core, contracts)
  def resources = Task.Sources("src/main/resources")
  // Versions pinned per docs/DESIGN.md section 2: pgjdbc 42.7.13,
  // HikariCP 7.1.0, Flyway 13.6.0 (PostgreSQL support is a separate artifact),
  // scribe 3.19.0 (scribe-slf4j2 routes slf4j library logs through scribe),
  // micrometer 1.17.1 (DESIGN pins 1.17.x).
  def mvnDeps = Seq(
    mvn"org.postgresql:postgresql:42.7.13",
    mvn"com.zaxxer:HikariCP:7.1.0",
    mvn"org.flywaydb:flyway-core:13.6.0",
    mvn"org.flywaydb:flyway-database-postgresql:13.6.0",
    mvn"com.outr::scribe:3.19.0",
    mvn"com.outr::scribe-slf4j2:3.19.0",
    mvn"io.micrometer:micrometer-core:1.17.1",
    mvn"io.micrometer:micrometer-registry-prometheus:1.17.1"
  )
  object test extends DosecordTests:
    // testcontainers-scala 0.44.1 per docs/DESIGN.md section 2 (pulls testcontainers 1.21.x).
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.dimafeng::testcontainers-scala-postgresql:0.44.1",
      mvn"com.dimafeng::testcontainers-scala-munit:0.44.1"
    )

object `adapter-console` extends DosecordModule:
  def moduleDeps = Seq(core, contracts)
  object test extends DosecordTests:
    // M0.13: the adapter conformance suite (tests/conformance) runs inside this module's test task.
    def moduleDeps = super.moduleDeps ++ Seq(tests.conformance)

object app extends DosecordModule:
  def moduleDeps = Seq(`adapter-console`, infra, core, contracts)
  def mainClass = Some("dosecord.app.Main")
  // Tapir 1.13.31 pinned per docs/DESIGN.md section 2: netty-sync serves
  // /healthz (M0.5), later /readyz, /metrics and the auth-link pages.
  def mvnDeps = Seq(mvn"com.softwaremill.sttp.tapir::tapir-netty-server-sync:1.13.31")
  // Mill 1.1.9's default assembly rules do not merge META-INF/services, which
  // drops Flyway's flyway-database-postgresql plugin registration.
  def assemblyRules = mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*", "\n") +: super.assemblyRules
  object test extends DosecordTests

object tests extends Module:
  object conformance extends DosecordModule:
    def moduleDeps = Seq(core, contracts)
    object test extends DosecordTests
  // M1.11: the 30-day scenario simulation drives the real loop, dispatcher, decide FSM and
  // intake handlers on Testcontainers Postgres through the console adapter; the harness reuses
  // the M1.5 Fixtures builder and PgSuite container harness from infra's test module.
  object simulation extends DosecordModule:
    def moduleDeps = Seq(core, contracts, infra, `adapter-console`)
    object test extends DosecordTests:
      def moduleDeps = super.moduleDeps ++ Seq(infra.test)
      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"com.dimafeng::testcontainers-scala-postgresql:0.44.1",
        mvn"com.dimafeng::testcontainers-scala-munit:0.44.1"
      )
