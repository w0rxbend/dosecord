# Dosecord configuration (DESIGN.md section 12).
#
# GENERATED FILE — do not edit by hand. Regenerate with:
#   ./mill app.test.runMain dosecord.app.envExampleGenerate .env.example
# The committed copy is diff-checked in CI (dosecord.app.envExampleCheck).
#
# Every variable may instead be supplied as <NAME>_FILE pointing at a file
# (Docker secret) whose content becomes the value.

# Comma-separated adapters to start; each non-console vendor needs its credentials below.
# (required)
ENABLED_ADAPTERS=console

# JDBC URL; pgjdbc takes credentials as query parameters (or use DATABASE_URL_FILE).
# (required, secret — prefer <NAME>_FILE)
DATABASE_URL=jdbc:postgresql://localhost:5432/dosecord?user=dosecord&password=change-me

# HMAC keys for callback tokens (ADR-006): '<id>:<base64url>'[, '<id>:<base64url>']; first signs, both verify.
# (required, secret — prefer <NAME>_FILE)
CALLBACK_KEYS=0:MDEyMzQ1Njc4OWFiY2RlZg

# Process role: gateway | worker | all (wired in M4.3).
# (optional, default: all)
ROLE=all

# Stable id of this process instance (worker_heartbeat); defaults to the hostname.
# (optional)
INSTANCE_ID=dosecord-1

# DEBUG | INFO | WARN | ERROR.
# (optional, default: INFO)
LOG_LEVEL=INFO

# json | plain.
# (optional, default: json)
LOG_FORMAT=json

# Actor handle of the console adapter; required when the console adapter is enabled.
# (optional)
CONSOLE_USER_ID=owner

# Discord bot token; required when the discord adapter is enabled.
# (optional, secret — prefer <NAME>_FILE)
DISCORD_TOKEN=change-me

# Telegram bot token; required when the telegram adapter is enabled.
# (optional, secret — prefer <NAME>_FILE)
TELEGRAM_TOKEN=change-me

# Zulip realm base URL; required (with ZULIP_EMAIL/ZULIP_API_KEY) when the zulip adapter is enabled.
# (optional)
ZULIP_SITE=https://zulip.example.com

# Zulip bot email.
# (optional)
ZULIP_EMAIL=bot@zulip.example.com

# Zulip bot API key.
# (optional, secret — prefer <NAME>_FILE)
ZULIP_API_KEY=change-me

# Matrix homeserver URL; required (with MATRIX_USER/MATRIX_TOKEN) when the matrix adapter is enabled.
# (optional)
MATRIX_HOMESERVER=https://matrix.example.com

# Matrix bot user id.
# (optional)
MATRIX_USER=@dosecord:matrix.example.com

# Matrix access token.
# (optional, secret — prefer <NAME>_FILE)
MATRIX_TOKEN=change-me

# External base URL of the auth-link page (M4.1); unused until then.
# (optional)
PUBLIC_BASE_URL=https://dosecord.example.com
